# Copy this file to .env and fill in your real values.
# The system runs in MOCK MODE (no external calls, no cost) if OPENAI_API_KEY is left blank.

# OpenAI API key. Leave blank to run the whole pipeline in mock mode.
OPENAI_API_KEY=

# Slack incoming webhook URL. Leave blank to skip Slack alerts (report is still generated locally).
SLACK_WEBHOOK_URL=

# Which model to use for the feature under test.
OPENAI_MODEL=gpt-4o-mini
